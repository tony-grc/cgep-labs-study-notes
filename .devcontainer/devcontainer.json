{
  "name": "CGE-P Labs",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Credentials and gcloud config survive a container rebuild. Without these,
  // every rebuild costs another `aws login` and another `gcloud auth`.
  // They are named volumes, not host mounts, so this works identically in a
  // Codespace where there is no host ~/.aws to bind.
  "mounts": [
    "source=cgep-aws,target=/home/vscode/.aws,type=volume",
    "source=cgep-gcloud,target=/home/vscode/.config/gcloud,type=volume"
  ],

  // The volumes mount as root; the labs run as vscode.
  // Fix ownership of the volumes, then make sure the profile AWS_PROFILE points
  // at actually exists. Without this the container starts with an empty
  // ~/.aws/config while AWS_PROFILE is already set to cgep, so every aws and
  // terraform command fails with "The config profile (cgep) could not be found"
  // before the student has done anything wrong. Idempotent: it appends only if
  // the stanza is missing, and it writes no credentials, only the instruction
  // to resolve them through the CLI.
  "postStartCommand": "sudo chown -R vscode:vscode /home/vscode/.aws /home/vscode/.config/gcloud && grep -q '^\\[profile cgep\\]' /home/vscode/.aws/config 2>/dev/null || printf '\\n[profile cgep]\\nregion = us-east-1\\ncredential_process = aws configure export-credentials --profile default --format process\\n' >> /home/vscode/.aws/config; grep -q cgep.env /home/vscode/.bashrc || echo 'if [ -f \"${containerWorkspaceFolder}/cgep.env\" ]; then . \"${containerWorkspaceFolder}/cgep.env\"; fi' >> /home/vscode/.bashrc",

  // The bashrc line is installed here rather than by hand because ~/.bashrc
  // lives in the image, not in a mounted volume, so a container rebuild throws
  // it away. postStartCommand runs on every start, so it comes back. It also
  // uses containerWorkspaceFolder rather than a fixed path: your repository is
  // named whatever you named it, and in a container it is under /workspaces.
  //
  // The profile the postStartCommand guarantees. You still run `aws login
  // --remote --profile default` yourself; the container holds no credentials.
  "remoteEnv": {
    "AWS_PROFILE": "cgep",
    "AWS_REGION": "us-east-1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "tsandall.opa",
        "ms-python.python",
        "redhat.vscode-yaml"
      ]
    }
  },

  "remoteUser": "vscode"
}
