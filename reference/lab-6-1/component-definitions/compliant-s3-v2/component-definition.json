                "uuid": "abeceb5c-50f2-47e1-bf17-47bca6d6804d",
                "control-id": "ac-3",
                "description": "AC-3 - Access Enforcement (no public GCS, no open management ports) Enforced in the pipeline by Rego policy data.compliance.ac3, severity critical. Remediation: Set uniform_bucket_level_access = true and public_access_prevention = enforced. For firewalls, narrow source_ranges.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "implemented"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_s3_bucket_public_access_block.primary"
                  },
                  {
                    "name": "enforced-by-policy",
                    "value": "data.compliance.ac3"
                  }
                ],
